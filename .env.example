# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Safe for browsers; RLS protects the data.
# Do NOT put the service_role / secret key here. This app does not need it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional. Max upload size in bytes. Keep below 4.5 MB on Vercel. Default 4 MB.
MAX_UPLOAD_BYTES=4194304

# Optional. Local port. Default 3000.
PORT=3000
